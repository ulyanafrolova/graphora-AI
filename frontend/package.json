{
  "name": "graphora-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:types": "json2ts -i ../schema/graph.schema.json -o src/api/graph.gen.ts --bannerComment \"// generated from schema/graph.schema.json by npm run gen:types\" && prettier --write src/api/graph.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "cytoscape": "^3.35.0",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-svg": "^0.4.0",
    "d3-hierarchy": "^3.1.3",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/cytoscape": "^3.21.9",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "^3.0.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
